# ⚔️ SynapseGuild Environment Configuration
# Copy this file to .env or run ./install.sh for interactive setup!

# 🧠 AI Gateway / LLM API Configuration (OpenAI-compatible)
# You can use OpenAI, OpenRouter, Groq, Ollama, DeepSeek, or 9Router
SYNAPSE_AI_API_KEY=your_api_key_here
SYNAPSE_AI_BASE_URL=https://openrouter.ai/api/v1
SYNAPSE_AI_MODEL=deepseek/deepseek-chat

# 📱 Dedicated Telegram Remote Bot (Optional)
SYNAPSE_TELEGRAM_BOT_TOKEN=
SYNAPSE_ADMIN_CHAT_ID=

# 🌐 Server Port & Host Configuration
SYNAPSE_PORT=8100
SYNAPSE_HOST=0.0.0.0
SYNAPSE_CLEANUP_TTL_SECONDS=900
